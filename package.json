{
  "name": "savora",
  "private": true,
  "version": "1.0.0",
  "description": "Plateforme de commande et de gestion pour la restauration rapide — Mon restaurant, Ouahigouya",
  "author": "Ange Stephane Sawadogo",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "apps/api",
    "apps/client",
    "apps/restaurant"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "demarrer": "node scripts/demarrer.mjs",
    "servir": "node scripts/servir-production.mjs",
    "partager": "node scripts/partager.mjs",
    "verifier:pwa": "node scripts/verifier-pwa.mjs",
    "verifier:iphone": "node scripts/verifier-iphone.mjs",
    "verifier:parcours": "node scripts/verifier-parcours.mjs",
    "verifier:logiciel": "node scripts/verifier-logiciel.mjs",
    "verifier:pages": "node scripts/verifier-pages.mjs",
    "verifier:empaquetage": "node scripts/verifier-empaquetage.mjs",
    "verifier:apk": "node scripts/verifier-apk.mjs",
    "check:sources": "node scripts/check-sources.mjs",
    "test": "npm run check:sources && vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --write .",
    "db:up": "docker compose -f infra/docker-compose.yml up -d",
    "db:down": "docker compose -f infra/docker-compose.yml down",
    "db:migrate": "npm run db:migrate --workspace @savora/api",
    "db:seed": "npm run db:seed --workspace @savora/api",
    "db:studio": "npm run db:studio --workspace @savora/api",
    "dev": "npm run dev --workspace @savora/api",
    "dev:client": "npm run dev --workspace @savora/client",
    "dev:restaurant": "npm run dev --workspace @savora/restaurant",
    "build:desktop": "npm run build --workspace @savora/restaurant && node scripts/preparer-desktop.mjs",
    "icons": "node scripts/generer-icones.mjs",
    "preparer:serveur": "node scripts/preparer-serveur-embarque.mjs",
    "build:desktop:complet": "npm run build --workspace @savora/api && npm run build:desktop && npm run preparer:serveur"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "playwright": "^1.63.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
