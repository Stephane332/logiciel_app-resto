# Interfaces web (application cliente et logiciel restaurant).
#
# Construction Vite, puis service par nginx. L'argument APP choisit laquelle des deux est construite.

FROM node:22-alpine AS builder
ARG APP=client
ARG VITE_API_URL=/api/v1
ARG VITE_REALTIME_URL=

WORKDIR /app

COPY package.json package-lock.json ./
COPY packages/shared/package.json ./packages/shared/
COPY packages/ui/package.json ./packages/ui/
COPY packages/api-client/package.json ./packages/api-client/
COPY apps/${APP}/package.json ./apps/${APP}/

RUN npm ci --workspace @savora/${APP} --include-workspace-root

COPY packages ./packages
COPY apps/${APP} ./apps/${APP}

ENV VITE_API_URL=${VITE_API_URL}
ENV VITE_REALTIME_URL=${VITE_REALTIME_URL}

RUN npm run build --workspace @savora/${APP}

# ---------------------------------------------------------------------------

FROM nginx:1.27-alpine AS runtime
ARG APP=client

COPY --from=builder /app/apps/${APP}/dist /usr/share/nginx/html
COPY infra/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
