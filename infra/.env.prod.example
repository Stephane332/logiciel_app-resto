# Copiez en infra/.env.prod et renseignez les valeurs réelles.
# Ce fichier ne doit jamais être versionné.

# ─────────────────────────────────────────────────────────────────────────────
#  Le domaine. C'est la seule valeur qui décide des adresses en service.
# ─────────────────────────────────────────────────────────────────────────────
#
#   DOMAINE=monresto.bf  donne  https://monresto.bf      (les clients)
#                        et     https://pro.monresto.bf  (l'équipe)
#
# Les deux noms doivent pointer sur l'IP du serveur — un enregistrement A chacun — et les ports 80
# et 443 être ouverts. Caddy s'occupe des certificats.
DOMAINE=monresto.bf

# Adresse pour les avis d'expiration de certificat. Let's Encrypt l'exige.
ADMIN_EMAIL=vous@exemple.bf

# ─────────────────────────────────────────────────────────────────────────────
#  Base de données
# ─────────────────────────────────────────────────────────────────────────────
POSTGRES_USER=savora
POSTGRES_PASSWORD=<mot-de-passe-long-et-aleatoire>
POSTGRES_DB=savora

# ─────────────────────────────────────────────────────────────────────────────
#  Secrets — à générer, jamais à inventer
# ─────────────────────────────────────────────────────────────────────────────
# openssl rand -base64 48
JWT_SECRET=<secret-aleatoire-48-octets>

# ─────────────────────────────────────────────────────────────────────────────
#  Adresses publiques, dérivées du domaine ci-dessus
# ─────────────────────────────────────────────────────────────────────────────
# Chaque interface appelle l'API sous son propre domaine : il n'y a donc pas d'appel entre origines
# dans le fonctionnement normal. Ces deux valeurs restent utiles au serveur — pour les liens qu'il
# écrit dans les notifications, et pour refuser toute origine qu'il ne connaît pas.
CORS_ORIGINS=https://monresto.bf,https://pro.monresto.bf

# L'application cliente publiée gratuitement en HTTPS, si tes clients l'ouvrent depuis ce lien.
# Elle vit alors sur un autre domaine que cette API : sans cette ligne, le navigateur jette chacune
# de ses réponses et l'application reste vide, sans qu'aucun journal du serveur ne le signale.
# Sur github.io l'origine est celle du compte, pas du dépôt : l'autoriser autorise tout ce compte.
PWA_ORIGINS=https://toncompte.github.io
PUBLIC_CLIENT_URL=https://monresto.bf

# ─────────────────────────────────────────────────────────────────────────────
#  Paiement
# ─────────────────────────────────────────────────────────────────────────────
# « declared » : Mobile Money déclaré par le client, attesté par le restaurant (ADR 008). C'est le
# mode qui ne demande aucun contrat d'agrégateur, et celui avec lequel le logiciel démarre.
PAYMENT_PROVIDER=declared
PAYMENT_WEBHOOK_SECRET=<inutile en mode declared ; requis avec un agregateur>

# ─────────────────────────────────────────────────────────────────────────────
#  Plateforme : où le restaurant reverse la commission (ADR 009)
# ─────────────────────────────────────────────────────────────────────────────
PLATFORM_NAME=Savora
PLATFORM_MOMO_NUMBER=<le numero qui recoit le reversement>
PLATFORM_MOMO_OPERATOR=ORANGE_MONEY
