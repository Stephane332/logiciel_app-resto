node_modules/
dist/
build/
coverage/
.env
.env.*
# Les fichiers d'exemple sont de la documentation, pas des secrets : ils décrivent quoi renseigner,
# sans jamais contenir de valeur réelle. `.env.*` les emportait — et le dépôt ne contenait donc pas
# `infra/.env.prod.example`, que le guide de déploiement demande de copier à sa première commande.
!.env.example
!.env.*.example
*.log
.DS_Store
.vite/
.turbo/
apps/client/dev-dist/
# Le projet Android de Capacitor est versionné : l'intégration continue en a besoin pour
# construire l'APK, et il contient des réglages faits à la main (icônes, liens profonds).
# Seuls les artefacts de construction sont exclus.
apps/*/android/build/
apps/*/android/app/build/
apps/*/android/.gradle/
apps/*/android/local.properties
apps/*/android/capacitor-cordova-android-plugins/
apps/*/ios/
*.keystore
*.jks
prisma/*.db

# Sorties de compilation TypeScript tombées à côté des sources.
# Vite résout « ./Checkout » en .js AVANT .tsx : un fichier compilé oublié dans src/ prend
# silencieusement la place du source et l'application tourne sur du code mort. Jamais versionnés.
apps/*/src/**/*.js
apps/*/src/**/*.jsx
apps/*/src/**/*.d.ts
apps/*/src/**/*.js.map
apps/*/src/**/*.d.ts.map
packages/*/src/**/*.js
packages/*/src/**/*.jsx
packages/*/src/**/*.d.ts
packages/*/src/**/*.js.map
packages/*/src/**/*.d.ts.map

# Photos envoyées par le restaurant en développement : des données, pas du code.
apps/api/uploads/
# UPLOAD_DIR vaut « ./uploads » par défaut : le dossier se crée donc là où l'API est lancée, et
# `npm run dev` la lance depuis la racine — d'où cette seconde ligne. Sans elle, les photos
# téléversées par un restaurant, ou fabriquées par un test, entrent dans le dépôt au premier
# `git add -A`. C'est déjà arrivé une fois : 80 images de démonstration s'étaient glissées dans un
# commit qui parlait d'autre chose.
/uploads/

# Application Windows : interface copiée à la construction, et sortie de l'empaqueteur.
apps/desktop/web/
apps/desktop/release/

# Le serveur embarqué, assemblé par scripts/preparer-serveur-embarque.mjs : plusieurs centaines de
# mégaoctets de binaires qui se reconstruisent à la demande. Ils n'ont rien à faire dans un dépôt.
apps/desktop/api/
apps/desktop/node/
apps/desktop/postgres/

# Exception à `build/` ci-dessus. `apps/desktop/build/` n'est pas une sortie de construction mais le
# dossier de ressources d'electron-builder : l'icône de l'installateur y vit, et elle doit être
# versionnée pour que l'intégration continue la trouve. Sans cette exception, electron-builder ne
# s'arrête pas — il retombe sur l'icône d'Electron, et le logiciel s'installe sous un logo étranger.
!apps/desktop/build/
!apps/desktop/build/**

# Configurations compilées à la racine d'un espace de travail : Vite préfère le .js au .ts et
# lirait une configuration périmée sans que rien ne le signale.
apps/*/*.config.js
apps/*/*.config.d.ts
apps/*/*.config.js.map
apps/*/*.config.d.ts.map
packages/*/*.config.js
packages/*/*.config.d.ts
