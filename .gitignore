apps/client/dev-dist/
# Le projet Android de Capacitor est versionné : l'intégration continue en a besoin pour
# construire l'APK, et il contient des réglages faits à la main (icônes, liens profonds).
# Seuls les artefacts de construction sont exclus.
apps/*/android/build/
apps/*/android/app/build/
apps/*/android/.gradle/
apps/*/android/local.properties
apps/*/android/capacitor-cordova-android-plugins/
apps/*/ios/
*.keystore
*.jks
prisma/*.db

# Sorties de compilation TypeScript tombées à côté des sources.
# Vite résout « ./Checkout » en .js AVANT .tsx : un fichier compilé oublié dans src/ prend
# silencieusement la place du source et l'application tourne sur du code mort. Jamais versionnés.
apps/*/src/**/*.js
apps/*/src/**/*.jsx
apps/*/src/**/*.d.ts
apps/*/src/**/*.js.map
apps/*/src/**/*.d.ts.map
packages/*/src/**/*.js
packages/*/src/**/*.jsx
packages/*/src/**/*.d.ts
packages/*/src/**/*.js.map
packages/*/src/**/*.d.ts.map

# Photos envoyées par le restaurant en développement : des données, pas du code.
apps/api/uploads/

# Application Windows : interface copiée à la construction, et sortie de l'empaqueteur.
apps/desktop/web/
apps/desktop/release/
