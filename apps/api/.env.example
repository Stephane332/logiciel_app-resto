# Base de données
DATABASE_URL="postgresql://barabite:barabite@localhost:5432/barabite?schema=public"

# Serveur
PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# Secrets — À REMPLACER EN PRODUCTION (openssl rand -base64 48)
JWT_SECRET="dev-secret-a-remplacer-imperativement-en-production"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS=30

# Origines autorisées pour les interfaces
CORS_ORIGINS="http://localhost:5173,http://localhost:5174"

# URL publique de l'application cliente (QR Codes de table)
PUBLIC_CLIENT_URL="http://localhost:5173"

# Paiement — sandbox tant qu'aucun agrégateur n'est contractualisé (ADR 007)
PAYMENT_PROVIDER=sandbox
PAYMENT_WEBHOOK_SECRET="dev-webhook-secret"
