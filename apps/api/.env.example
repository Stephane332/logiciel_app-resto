# Base de données
DATABASE_URL="postgresql://barabite:barabite@localhost:5432/barabite?schema=public"

# Serveur
PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# Secrets — À REMPLACER EN PRODUCTION (openssl rand -base64 48)
JWT_SECRET="dev-secret-a-remplacer-imperativement-en-production"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS=30

# Origines autorisées pour les interfaces
CORS_ORIGINS="http://localhost:5173,http://localhost:5174"

# URL publique de l'application cliente (QR Codes de table)
PUBLIC_CLIENT_URL="http://localhost:5173"

# Paiement.
#   declared : Mobile Money sans agrégateur — le client déclare, le restaurant atteste (ADR 008).
#              Ne coûte rien, fonctionne aujourd'hui. C'est le défaut.
#   sandbox  : fournisseur simulé, pour la démonstration.
#   cinetpay / ligdicash : agrégateur payant, si un compte marchand est ouvert (ADR 007).
PAYMENT_PROVIDER=declared
PAYMENT_WEBHOOK_SECRET="dev-webhook-secret"

# --- Plateforme : commission (ADR 009) ---
# Numéro qui reçoit le reversement de la commission, et modèle du code de transfert.
PLATFORM_NAME=BaraBite
PLATFORM_MOMO_NUMBER=66798031
PLATFORM_MOMO_OPERATOR=ORANGE_MONEY
PLATFORM_MOMO_USSD=*144*2*1*{NUM}*{MONTANT}#
